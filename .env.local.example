# Supabase
# Project API URL — format: https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Find it: Dashboard → Settings → API → "Project URL"
# ⚠️  NOT the dashboard URL (https://supabase.com/dashboard/project/...)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Dashboard → Settings → API → "anon public"
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Dashboard → Settings → API → "service_role secret"  ← never expose client-side
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend email (https://resend.com — free tier supports 3,000 emails/month)
# Create an API key at https://resend.com/api-keys
# Domain "electric-deals.com" must be verified in Resend before production use
RESEND_API_KEY=re_your_key_here

# Resend webhook signing secret — used by /api/webhooks/resend to verify
# that inbound webhook calls genuinely come from Resend.
# Find it in Resend Dashboard → Webhooks → your webhook → Signing Secret.
# If unset the webhook will still process events (dev mode), but MUST be
# configured in production to prevent spoofed bounce/complaint requests.
RESEND_WEBHOOK_SECRET=your-webhook-secret-here

# Cron secret — set the same value in Vercel environment variables
# Generate with: openssl rand -hex 32
CRON_SECRET=your-random-secret-here
